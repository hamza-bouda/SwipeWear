# Backend base URL used by mobile/src/api/config.ts.
# Leave unset for local dev: falls back to http://10.0.2.2:8000 (Android)
# or http://localhost:8000 (iOS/web).
EXPO_PUBLIC_API_URL=https://swipewear-api.example.com

# ── Supabase (authentication) ────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
#
# Both values are meant to be public: they identify the project and are
# compiled into the app bundle. The *service role* key is a different thing
# entirely — it bypasses every rule and must never appear here or in any
# EXPO_PUBLIC_ variable. It belongs to the backend only.
#
# Without these the app still runs: browsing works under an anonymous identity
# and the sign-in screen says it is unavailable rather than failing obscurely.
EXPO_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
