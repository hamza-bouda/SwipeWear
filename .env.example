# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

POSTGRES_DB=swipewear
POSTGRES_USER=swipewear
POSTGRES_PASSWORD=swipewear_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://swipewear:swipewear_dev@localhost:5432/swipewear

# ── eBay Browse API (KAN-23) ──────────────────────────────────────────────────
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_ENV=sandbox

# ── Environnement (KAN-88) ────────────────────────────────────────────────────
# 'development' (défaut), 'staging' ou 'production'.
# Hors development, l'API refuse de démarrer sur un secret par défaut, ne sert
# jamais de produits factices (503 à la place) et interdit store.reset().
APP_ENV=development

# ── Awin affiliate connector (KAN-26) ─────────────────────────────────────────
AWIN_API_TOKEN=your-awin-api-token
AWIN_PUBLISHER_ID=your-awin-publisher-id

# ── Affiliate tracking (KAN-46) ──────────────────────────────────────────────
# Master switch (KAN-87). Off by default: having the credentials below is not
# the same as the programme having approved the account, and a deep link built
# against a pending programme is a dead link for the user. Until then the app
# serves the seller's direct URL. Set to true once each network is confirmed.
AFFILIATE_LINKS_ENABLED=false

# eBay image variant requested at ingestion (KAN-87). s-l500 clears
# FashionSigLIP's 224 px input on both edges at ~67 KB; s-l225 would be
# upscaled, s-l1600 costs 8x the bandwidth for detail the model discards.
EBAY_IMAGE_SIZE=500

# eBay Partner Network (EPN) — see SETUP.md for how to obtain these
EPN_PROGRAM_ID=your-epn-program-id
EPN_CAMPAIGN_ID=your-epn-campaign-id

# CJ Affiliate — see SETUP.md for how to obtain this
CJ_PUBLISHER_ID=your-cj-publisher-id

# ── Price ladder config (KAN-54) ─────────────────────────────────────────────
LADDER_MIN_SIMILARITY=0.70

# ── Auth (KAN-52, KAN-90) ────────────────────────────────────────────────────
# Signs the throwaway identity handed to a visitor browsing without an account.
# Accounts themselves are signed by Supabase, below.
JWT_SECRET=change-me-to-a-random-secret

# ── Supabase (identity provider, KAN-90) ─────────────────────────────────────
# The backend stores no password: it verifies the access token Supabase issues
# and provisions the local account behind it.
#
# SUPABASE_URL — Project Settings → API → Project URL. Without it, sign-in is
# unavailable and POST /auth/sync answers 503 rather than pretending to work.
SUPABASE_URL=https://yourproject.supabase.co

# Needed only by projects still on the legacy shared HS256 secret
# (Project Settings → API → JWT Settings). Leave empty on projects using
# asymmetric signing keys, which are verified through the public JWKS endpoint.
SUPABASE_JWT_SECRET=

# Admin key, used for one thing: erasing the identity at the provider when a
# user deletes their account. Without it, deletion refuses rather than removing
# our rows while leaving the account able to sign back in.
# NEVER expose this to the app — it bypasses every access rule.
SUPABASE_SERVICE_ROLE_KEY=
